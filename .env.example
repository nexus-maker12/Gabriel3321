# Puerto local
PORT=3500

# Dejar vacío para almacenamiento local; configurar con credenciales propias para MongoDB.
MONGODB_URI=

# Solo para crear el primer superadministrador de una instalación vacía (mínimo 8 caracteres).
INITIAL_ADMIN_PASSWORD=

# Opcional: local fuerza almacenamiento local, incluso si existe MONGODB_URI.
AUREA_STORAGE=
