# Nexus por Mayor - Configuración de Entorno & MongoDB Atlas

# Puerto del Servidor HTTP
PORT=3500

# Cadena de Conexión de MongoDB Atlas
# Pega aquí tu URI de conexión que te da MongoDB Atlas:
# Ejemplo: mongodb+srv://usuario_nexus:TuPasswordSeguro@cluster0.abcde.mongodb.net/nexus_por_mayor?retryWrites=true&w=majority
MONGODB_URI=

# Modo de Almacenamiento: 'auto' (se conecta a Atlas si MONGODB_URI está configurado, o usa local si está vacío)
DB_MODE=auto
